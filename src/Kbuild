# Kbuild configuration for Krynox Nexus kernel modules
#
# This file defines which modules to build and their dependencies

# Secure example modules
obj-m += examples/hello_secure.o

# Vulnerable modules for security testing
# WARNING: These contain intentional vulnerabilities!
obj-m += vulnerable/buffer_overflow.o
obj-m += vulnerable/use_after_free.o

# Compiler flags for enhanced security checks
ccflags-y := -Wall -Wextra -Werror
ccflags-y += -Wformat-security
ccflags-y += -Wstack-protector
ccflags-y += -fno-strict-overflow
ccflags-y += -fno-delete-null-pointer-checks

# Enable additional warnings for security
ccflags-y += -Warray-bounds
ccflags-y += -Wformat-overflow
ccflags-y += -Wstringop-overflow

# Debug symbols for analysis tools
ccflags-y += -g

# Module information
KVERSION := $(shell uname -r)
KDIR := /lib/modules/$(KVERSION)/build
PWD := $(shell pwd)

# Build targets
all:
	$(MAKE) -C $(KDIR) M=$(PWD) modules

clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean

install:
	$(MAKE) -C $(KDIR) M=$(PWD) modules_install

help:
	@echo "Krynox Nexus Kernel Module Build System"
	@echo ""
	@echo "Available targets:"
	@echo "  all      - Build all kernel modules"
	@echo "  clean    - Remove build artifacts"
	@echo "  install  - Install modules to system"
	@echo "  help     - Show this help message"
	@echo ""
	@echo "Modules:"
	@echo "  Secure Examples:"
	@echo "    - hello_secure.ko"
	@echo ""
	@echo "  Vulnerable (Testing Only):"
	@echo "    - buffer_overflow.ko"
	@echo "    - use_after_free.ko"